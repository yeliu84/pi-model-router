{
  "$schema": "./model-router.schema.json",
  "debug": false,
  "autoPinFirstTurnDecision": false,
  "classifierModel": "auto",
  "phaseBias": 0.5,
  "maxSessionBudget": 1.0,
  "models": {
    "astra": {
      "model": "openai/gpt-6.2-astra",
      "contextWindow": 272000,
      "maxTokens": 128000,
      "thinkingLevels": ["xhigh", "high", "medium", "low"]
    },
    "sol": {
      "model": "openai/gpt-6.2-sol",
      "contextWindow": 272000,
      "maxTokens": 128000,
      "thinkingLevels": ["xhigh", "high", "medium", "low"]
    },
    "flash": {
      "model": "google/gemini-flash-latest",
      "contextWindow": 1048576
    },
    "luna": {
      "model": "openai/gpt-6-luna",
      "contextWindow": 272000,
      "maxTokens": 128000,
      "reasoning": false
    },
    "sonnet": {
      "model": "anthropic/claude-sonnet-5-5",
      "contextWindow": 1000000
    }
  },
  "rules": [
    {
      "matches": ["deploy", "production", "release"],
      "tier": "high",
      "reason": "Safety check for production tasks"
    },
    { "matches": "changelog", "tier": "low" }
  ],
  "profiles": {
    "auto": {
      "high": {
        "model": "astra",
        "thinking": "high",
        "fallbacks": ["sonnet"]
      },
      "medium": {
        "model": "sol",
        "thinking": "medium",
        "fallbacks": ["flash"]
      },
      "low": { "model": "luna", "thinking": "off" }
    },
    "cheap": {
      "high": { "model": "flash", "thinking": "low" },
      "medium": { "model": "luna", "thinking": "off" },
      "low": { "model": "google/gemini-flash-lite-latest", "thinking": "off" }
    },
    "deep": {
      "high": {
        "model": "anthropic/claude-opus-5-5",
        "thinking": "max",
        "thinkingLevels": ["max", "xhigh", "high", "medium", "low"]
      },
      "medium": { "model": "astra", "thinking": "high" },
      "low": { "model": "flash", "thinking": "low" }
    },
    "anthropic": {
      "high": {
        "model": "anthropic/claude-opus-5-5",
        "thinking": "high"
      },
      "medium": {
        "model": "sonnet",
        "thinking": "medium"
      },
      "low": { "model": "anthropic/claude-haiku-5-5", "thinking": "low" }
    }
  }
}
